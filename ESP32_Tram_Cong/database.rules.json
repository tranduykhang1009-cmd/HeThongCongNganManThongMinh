{
  "rules": {
    "admins": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() == true"
    },
    "web_users": {
      ".read": "root.child('admins').child(auth.uid).val() == true",
      ".write": "root.child('admins').child(auth.uid).val() == true",
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "tram_cong": {
      ".read": "auth != null && root.child('web_users').child(auth.uid).child('isBlocked').val() != true",
      ".write": "auth != null && root.child('web_users').child(auth.uid).child('isBlocked').val() != true"
    },
